#!/bin/bash
# rtssh — persistent tmux session over mosh.
#
# Usage: rtssh <host> [tmux-session-name]
#
# mosh authenticates once over ssh (one YubiKey touch), then runs over UDP
# with its own session key, so it survives sleep/wake, network changes and
# VPN toggles without re-authenticating. tmux on the far side provides
# scrollback and survives the mosh session itself going away.
#
# There is deliberately no reconnect loop. The previous ssh-based version
# retried forever on exit 255; with a touch-required key every missed touch
# became a failed auth, and the retries got the home IP banned by crowdsec
# (ssh-slow-bf) on purr. If the initial ssh step fails, we fail once.
#
# Needs mosh-server on the host and UDP 60000-61000 open to it.

set -euo pipefail

if [[ -z "${1:-}" ]]; then
    echo "usage: rtssh <host> [tmux-session-name]" >&2
    exit 1
fi
HOST="$1"
SESSION="${2:-main}"

exec mosh "$HOST" -- env EDITOR=vim tmux -u new -A -s "$SESSION"
